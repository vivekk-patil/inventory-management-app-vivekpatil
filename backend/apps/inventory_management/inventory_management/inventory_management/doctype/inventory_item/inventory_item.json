{
  "doctype": "DocType",
  "name": "Inventory Item",
  "module": "Inventory Management",
  "custom": 0,
  "istable": 0,
  "issingle": 0,
  "editable_grid": 1,
  "track_changes": 1,
  "autoname": "format:INV-{#####}",
  "sort_field": "modified",
  "sort_order": "DESC",
  "engine": "InnoDB",
  "fields": [
    {
      "fieldname": "item_name",
      "label": "Name",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1,
      "search_index": 1
    },
    {
      "fieldname": "description",
      "label": "Description",
      "fieldtype": "Small Text",
      "in_list_view": 1
    },
    {
      "fieldname": "image",
      "label": "Image",
      "fieldtype": "Attach Image",
      "in_list_view": 1
    },
    {
      "fieldname": "tags",
      "label": "Tags",
      "fieldtype": "Data",
      "description": "Comma-separated tags, e.g. Shirts, Pants",
      "in_list_view": 1,
      "in_standard_filter": 1,
      "search_index": 1
    },
    {
      "fieldname": "date_added",
      "label": "Date Added",
      "fieldtype": "Date",
      "default": "Today",
      "in_list_view": 1,
      "in_standard_filter": 1,
      "search_index": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "export": 1,
      "report": 1,
      "print": 1,
      "email": 1,
      "share": 1
    },
    {
      "role": "All",
      "read": 1
    }
  ]
}
